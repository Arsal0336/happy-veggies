{
  "Database": {
    "Provider": "Auto"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "HappyVeggie.Dev",
    "Audience": "HappyVeggie.FarmerApi",
    "SigningKey": "DevOnlySigningKeyChangeViaUserSecrets123!"
  },
  "Otp": {
    "UseMock": true
  },
  "Swagger": {
    "Enabled": true
  },
  "Weather": {
    "UseLive": false
  },
  "Soil": {
    "UseLive": false
  },
  "Llm": {
    "UseLive": false,
    "Provider": "dashscope",
    "Model": "qwen-plus",
    "ApiKey": "",
    "Endpoint": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "TimeoutSeconds": 45
  },
  "Providers": {
    "TimeoutSeconds": 5
  },
  "RateLimiting": {
    "Otp": { "PermitLimit": 5, "WindowSeconds": 60, "Partition": "ip" },
    "Plan": { "PermitLimit": 10, "WindowSeconds": 3600, "Partition": "user" },
    "Assistant": { "PermitLimit": 30, "WindowSeconds": 60, "Partition": "user" }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

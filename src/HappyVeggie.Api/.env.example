# HappyVeggie API — copy to a local .env or set as process env / user secrets.
# Prefer appsettings.Local.json for JSON-shaped overrides (also gitignored).
# Never commit real API keys, connection strings with passwords, or signing keys.

# SQL Server (leave empty to fall back to local SQLite under App_Data/)
ConnectionStrings__DefaultConnection=

# JWT — use a long random value in any shared/deployed environment
Jwt__SigningKey=REPLACE_WITH_A_LONG_RANDOM_SECRET

# OTP — mock for local/demo; set false only when a live SMS provider is wired
Otp__UseMock=true

# LLM — stub by default; enable live only with a real server-side key (prefer appsettings.Local.json)
Llm__UseLive=false
Llm__Provider=groq
Llm__Model=openai/gpt-oss-120b
Llm__ApiKey=
Llm__Endpoint=https://api.groq.com/openai/v1
Llm__TimeoutSeconds=60

# Weather / soil providers
Weather__UseLive=false
Soil__UseLive=false

# Database provider: Auto | SqlServer | Sqlite
Database__Provider=Auto
